# Dev: SQLite. Production: postgresql://user:pass@host:5432/db (đổi provider trong prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -hex 32
AUTH_SECRET=""
# Thông báo đẩy (Web Push). Tạo cặp khoá: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Email liên hệ của đơn vị vận hành (yêu cầu của chuẩn Web Push)
VAPID_SUBJECT="mailto:admin@truong.edu.vn"
