# ---------- Cơ sở dữ liệu PostgreSQL ----------
# Neon: Dashboard → Connect → bật "Connection pooling" để lấy DATABASE_URL (host có "-pooler", thêm &pgbouncer=true),
#       tắt pooling để lấy DIRECT_URL.
# Supabase: Project Settings → Database → Connection string:
#       DATABASE_URL = "Transaction pooler" (cổng 6543), thêm ?pgbouncer=true vào cuối
#       DIRECT_URL   = "Session pooler" hoặc "Direct connection" (cổng 5432)
# Chạy trên máy (docker compose up -d): cả hai dùng chung
DATABASE_URL="postgresql://chunhiem:chunhiem@localhost:5432/chunhiem"
DIRECT_URL="postgresql://chunhiem:chunhiem@localhost:5432/chunhiem"

# ---------- Đăng nhập ----------
# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -hex 32
AUTH_SECRET=""

# ---------- Thông báo đẩy (Web Push) ----------
# Tạo cặp khoá: npx web-push generate-vapid-keys — GIỮ NGUYÊN sau khi triển khai (đổi khoá = mọi thiết bị phải bật lại)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Email liên hệ của đơn vị vận hành (yêu cầu của chuẩn Web Push)
VAPID_SUBJECT="mailto:admin@truong.edu.vn"
