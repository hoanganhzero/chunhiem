// Mô hình đa trường (multi-tenant): mọi dữ liệu nghiệp vụ đều gắn với một School.
// Dev dùng SQLite; khi triển khai thật đổi provider sang "postgresql" và DATABASE_URL.
// Các trường kiểu "enum" lưu dạng String để chạy được trên cả SQLite và PostgreSQL
// (giá trị hợp lệ định nghĩa trong src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(cuid())
  code      String   @unique // mã trường, dùng khi đăng nhập / định danh
  name      String
  // Loại đơn vị: THPT | THCS | GDNN_GDTX (Trung tâm GDNN-GDTX) — quyết định cách gọi trên giao diện
  type      String   @default("THPT")
  address   String?
  phone     String?
  authority String? // cơ quan chủ quản, vd: Sở GD&ĐT TP. Hồ Chí Minh
  principal String? // hiệu trưởng
  location  String? // địa danh ghi ở chữ ký báo cáo, vd: TP. Hồ Chí Minh
  // Mật khẩu mặc định cấp cho tài khoản mới / khi đặt lại. Người dùng bắt buộc đổi ở lần đăng nhập đầu.
  defaultPassword String   @default("12345678")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  users           User[]
  academicYears   AcademicYear[]
  classes         Class[]
  students        Student[]
  subjects        Subject[]
  reportTemplates ReportTemplate[]
  announcements   Announcement[]
}

model User {
  id           String   @id @default(cuid())
  schoolId     String? // null = quản trị hệ thống (SUPER_ADMIN)
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Tên đăng nhập: giáo viên = email, học sinh = mã HS, phụ huynh = SĐT (chữ thường)
  username           String   @unique
  email              String?
  name               String
  phone              String?
  passwordHash       String
  // SUPER_ADMIN | SCHOOL_ADMIN (quản trị) | LEADER (BGH / Ban Giám đốc) | ACADEMIC (giáo vụ)
  // | TEACHER | STUDENT | PARENT
  role               String
  mustChangePassword Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  homeroomClasses Class[]         @relation("Homeroom")
  conductRecords  ConductRecord[]
  studentProfile  Student?        @relation("StudentAccount")
  children        Student[]       @relation("ParentAccount")
  announcements   Announcement[]
  messages        Message[]
  emulations      EmulationRecord[] @relation("EmulationRecorder")
  goals           Goal[]            @relation("GoalCreator")
  goalComments    GoalComment[]
  notifications   Notification[]
  pushSubs        PushSubscription[]
  // Các loại thông báo người dùng đã tắt, cách nhau bởi dấu phẩy (vd "ANNOUNCE,PRAISE")
  notifyOff       String            @default("")

  @@index([schoolId])
}

model AcademicYear {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String // vd: 2026-2027
  isCurrent      Boolean   @default(false)
  semester2Start DateTime? // ngày bắt đầu học kỳ 2 (mặc định 15/01)

  classes     Class[]
  evaluations ConductEvaluation[]
  grades      Grade[]

  @@unique([schoolId, name])
}

model Class {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name              String // vd: 10A1
  grade             Int
  homeroomTeacherId String?
  homeroomTeacher   User?        @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  students      Student[]
  attendances   Attendance[]
  announcements Announcement[]
  groups        ClassGroup[]
  criteria      EmulationCriterion[]
  emulations    EmulationRecord[]

  @@unique([academicYearId, name])
  @@index([schoolId])
}

model Student {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  code        String // mã học sinh
  fullName    String
  dob         DateTime?
  gender         String? // NAM | NU
  ethnicity      String?
  address        String?
  parentName     String?
  parentRelation String? // Bố | Mẹ | Người giám hộ
  parentPhone    String?
  note           String?
  status         String    @default("ACTIVE") // ACTIVE | TRANSFERRED | DROPPED
  createdAt      DateTime  @default(now())
  userId         String?   @unique
  user           User?     @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)
  parentUserId   String?
  parentUser     User?     @relation("ParentAccount", fields: [parentUserId], references: [id], onDelete: SetNull)

  attendances    Attendance[]
  conductRecords ConductRecord[]
  evaluations    ConductEvaluation[]
  grades         Grade[]
  messages       Message[]
  // Thi đua: tổ và chức vụ cán sự lớp (TO_TRUONG | LOP_TRUONG | LOP_PHO | BI_THU)
  groupId        String?
  group          ClassGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  classRole      String?
  emulations     EmulationRecord[] @relation("EmulationTarget")
  goals          Goal[]

  @@unique([schoolId, code])
  @@index([classId])
  @@index([parentUserId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime // lưu 00:00 UTC của ngày
  status    String // PRESENT | EXCUSED | UNEXCUSED | LATE
  note      String?

  @@unique([studentId, date])
  @@index([classId, date])
}

// Ghi nhận nề nếp hằng ngày: khen thưởng / vi phạm
model ConductRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String // PRAISE | VIOLATION
  content     String
  points      Int      @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([studentId])
}

// Đánh giá rèn luyện theo học kỳ (Thông tư 22: Tốt / Khá / Đạt / Chưa đạt)
model ConductEvaluation {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semester       Int // 1 | 2
  rating         String // TOT | KHA | DAT | CHUA_DAT
  comment        String?

  @@unique([studentId, academicYearId, semester])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code     String // vd: TOAN — dùng trong mẫu báo cáo {{diem_TOAN}}
  name     String
  type     String  @default("SCORE") // SCORE (đánh giá bằng điểm) | COMMENT (Đạt / Chưa đạt)
  order    Int     @default(0)
  active   Boolean @default(true)

  grades Grade[]

  @@unique([schoolId, code])
}

// Điểm theo Thông tư 22: TX (thường xuyên, idx 1..5), GK (giữa kỳ), CK (cuối kỳ),
// DG (môn đánh giá bằng nhận xét: score 1 = Đạt, 0 = Chưa đạt)
model Grade {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semester       Int
  kind           String
  idx            Int          @default(0)
  score          Float

  @@unique([studentId, subjectId, academicYearId, semester, kind, idx])
  @@index([subjectId, academicYearId, semester])
}

// Thông báo: classId = null nghĩa là thông báo toàn trường (BGH / giáo vụ gửi)
model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([classId, createdAt])
  @@index([schoolId, createdAt])
}

// Trao đổi giữa GVCN và phụ huynh, mỗi học sinh một luồng
model Message {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  fromFamily Boolean // true = phụ huynh gửi, false = giáo viên gửi
  content    String
  read       Boolean  @default(false) // người nhận đã đọc
  // CHAT = tin nhắn thường | REPORT = báo cáo định kỳ (phụ huynh bấm "Đã xem" → ackAt)
  kind       String    @default("CHAT")
  ackAt      DateTime?
  createdAt  DateTime @default(now())

  @@index([studentId, createdAt])
}

// Mẫu báo cáo Excel riêng của trường (có các ô {{...}})
model ReportTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  fileName  String
  data      Bytes
  createdAt DateTime @default(now())
}

// ---------- Thi đua ----------

model ClassGroup {
  id       String    @id @default(cuid())
  classId  String
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String // Tổ 1, Tổ 2…
  order    Int       @default(0)
  students Student[]

  @@index([classId])
}

// Tiêu chí cộng / trừ điểm thi đua của lớp (GVCN chỉnh sửa được)
model EmulationCriterion {
  id       String            @id @default(cuid())
  classId  String
  class    Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String
  category String // HOC_TAP | NE_NEP | HOAT_DONG
  points   Int // dương = cộng, âm = trừ
  active   Boolean           @default(true)
  order    Int               @default(0)
  // Tự áp dụng khi điểm danh: UNEXCUSED (vắng không phép) | LATE (đi muộn)
  auto     String?
  records  EmulationRecord[]

  @@index([classId])
}

// Một lần ghi nhận thi đua. Cán sự (tổ trưởng, bí thư…) ghi → PENDING, GVCN duyệt → APPROVED.
model EmulationRecord {
  id           String              @id @default(cuid())
  classId      String
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student             @relation("EmulationTarget", fields: [studentId], references: [id], onDelete: Cascade)
  criterionId  String?
  criterion    EmulationCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  label        String // tên tiêu chí tại thời điểm ghi (giữ lịch sử khi tiêu chí bị sửa)
  category     String
  points       Int
  note         String?
  date         DateTime
  status       String              @default("APPROVED") // PENDING | APPROVED | REJECTED
  source       String              @default("MANUAL") // MANUAL | ATTENDANCE (tự trừ khi điểm danh)
  recordedById String?
  recordedBy   User?               @relation("EmulationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([classId, date])
  @@index([studentId, date])
}

// Mục tiêu rèn luyện / học tập GVCN đặt cùng học sinh — phụ huynh theo dõi
model Goal {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | DONE | MISSED
  createdById String?
  createdBy   User?     @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  comments    GoalComment[]

  @@index([studentId])
}

// Phản hồi của phụ huynh / học sinh với mục tiêu: COMMIT = cam kết đồng hành, COMMENT = ý kiến
model GoalComment {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String   @default("COMMENT")
  content   String
  createdAt DateTime @default(now())

  @@index([goalId])
}

// ---------- Thông báo ----------

// Hộp thông báo trong ứng dụng (luôn có) — đồng thời gửi thông báo đẩy nếu người dùng đã bật
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // ATTENDANCE | PRAISE | WARNING | MESSAGE | REPORT | GOAL | ANNOUNCE | FEEDBACK
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// Đăng ký nhận thông báo đẩy của một thiết bị (trình duyệt / PWA)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
